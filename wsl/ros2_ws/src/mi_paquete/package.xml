<!-- En ~/ros2_ws/src/mi_paquete/package.xml -->
<package format="3">
  <name>mi_paquete</name>
  <version>0.0.1</version>
  <description>YOLOv7 integration with ROS2</description>
  
  <maintainer email="usuario@todo.com">usuario</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cv_bridge</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  
  <!-- PyTorch debe instalarse manualmente via pip en virtualenv -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>